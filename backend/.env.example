# Exact frontend origins, encoded as a JSON array. Add the actual Vite port if changed.
CREDISURE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

CREDISURE_DATABASE_PATH=data/credisure.sqlite3
CREDISURE_SESSION_MINUTES=30
# Login protection, per backend process. Limits include malformed requests.
CREDISURE_LOGIN_ATTEMPTS_PER_IP=10
CREDISURE_LOGIN_ATTEMPTS_TOTAL=100
CREDISURE_LOGIN_WINDOW_SECONDS=60
CREDISURE_LOGIN_CONCURRENCY=2
CREDISURE_LOGIN_BODY_BYTES=8192
CREDISURE_LOGIN_BODY_TIMEOUT_SECONDS=5
# Set these locally before running python -m app.seed. Never commit real credentials.
CREDISURE_ADMIN_EMAIL=
CREDISURE_ADMIN_PASSWORD=
